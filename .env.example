# Copy to .env and add your OpenAI API key. Never commit .env.
INFERENCE_PROVIDER=openai
OPENAI_API_KEY=
# Hugging Face token is only needed for dataset access/deployment in OpenAI mode.
HF_TOKEN=
# Optional separate token with read access to gaia-benchmark/GAIA, for attachment fallback.
HF_DATASET_TOKEN=
MODEL_ID=gpt-4.1
VISION_MODEL_ID=gpt-4.1
ASR_MODEL_ID=gpt-transcribe
HF_ASR_PROVIDER=hf-inference
MODEL_BASE_URL=https://api.openai.com/v1
MAX_STEPS=18
MAX_TOKENS=4096
REQUEST_TIMEOUT=90
# Optional: path to a Stockfish executable on Windows.
STOCKFISH_PATH=
# Space owner is allowed by default. Add other trusted users if desired.
ALLOWED_HF_USERS=
